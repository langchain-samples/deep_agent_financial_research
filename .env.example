# Copy to .env and fill in. Never commit .env.

# --- Model ---
DEFAULT_MODEL_PROVIDER=openai          # openai | anthropic
DEFAULT_MODEL=gpt-4o
# DEFAULT_TEMPERATURE=0.7               # omit to use the provider default (required for claude-sonnet-5-5)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- LangSmith tracing ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finance-research-agent
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU region / self-hosted only

# --- Evals ---
# EVAL_JUDGE_MODEL=openai:gpt-4o        # defaults to the agent's model

# --- Budgets ---
MAX_TOKENS=300000                       # total across main agent + subagents
MAX_TIME_MINUTES=10
MAX_ITERATIONS=200                      # LangGraph recursion limit per run

# --- Data sources (no API keys needed) ---
# SEC EDGAR requires a User-Agent identifying you: "<name or company> <email>"
SEC_USER_AGENT=
# NEWS_API_KEY=                         # optional; RSS feeds are used when unset

# --- Snowflake MCP (snowflake_analyst subagent; omitted when not configured) ---
# Option A (default): Snowflake-managed MCP server
SNOWFLAKE_MCP_TRANSPORT=streamable_http
SNOWFLAKE_MCP_URL=                      # https://<account>.snowflakecomputing.com/api/v2/databases/<DB>/schemas/<SCHEMA>/mcp-servers/<NAME>
SNOWFLAKE_PAT=                          # PAT for a least-privileged, read-only role
# Option B: local Snowflake-Labs server (deprecated by Snowflake)
# SNOWFLAKE_MCP_TRANSPORT=stdio
# SNOWFLAKE_MCP_SERVICE_CONFIG=config/snowflake_mcp_readonly.yaml
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=                   # PAT
# SNOWFLAKE_ROLE=
# SNOWFLAKE_WAREHOUSE=
